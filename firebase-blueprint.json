{
  "projectName": "DeliFar 2.0",
  "description": "Multi-tenant delivery, pickup, and electronic invoice signing platform powered by Google Firebase.",
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Isolated tenant organization owning stores, jobs, employees, invitations, invoices, and audit logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "defaultArea": { "type": "string", "enum": ["LA", "SAC"] },
        "storageUsedBytes": { "type": "integer", "minimum": 0 },
        "storageQuotaBytes": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer" },
        "modified": { "type": "integer" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerUid", "timezone", "defaultArea", "created", "modified"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Company member with a role (owner, manager, driver, accountant) and activation state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["owner", "manager", "driver", "accountant"] },
        "active": { "type": "boolean" },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "invitedByUid": { "type": "string", "maxLength": 128 },
        "joinedAt": { "type": "integer" },
        "lastActiveAt": { "type": "integer" }
      },
      "required": ["uid", "companyId", "displayName", "email", "role", "active", "joinedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Time-limited invitation created by a company Owner to onboard an employee with a specific role.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["manager", "driver", "accountant"] },
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 16 },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked", "expired"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "acceptedByUid": { "type": ["string", "null"], "maxLength": 128 }
      },
      "required": ["id", "companyId", "companyName", "email", "role", "inviteCode", "status", "createdByUid", "createdAt", "expiresAt"]
    },
    "Store": {
      "title": "Store",
      "description": "Business location with Google Place coordinates and weekly receiving hours.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "providerId": { "type": ["string", "null"], "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "archived": { "type": "boolean" },
        "hours": { "type": "array", "maxItems": 7 },
        "created": { "type": "integer" },
        "modified": { "type": "integer" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "companyId", "name", "address", "lat", "lon", "archived", "created", "modified", "version"]
    },
    "Job": {
      "title": "Job",
      "description": "Delivery or pickup job with product lines, schedule, status, issues, and driver assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["delivery", "pickup"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "time": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pending", "progress", "completed", "canceled"] },
        "issue": { "type": ["string", "null"], "enum": ["partial", "closed", "refused", "unavailable", "damaged", "unsigned", "other", null] },
        "issueNote": { "type": "string", "maxLength": 1000 },
        "assignedDriverUid": { "type": ["string", "null"], "maxLength": 128 },
        "assignedDriverName": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 2000 },
        "items": { "type": "array", "minItems": 1, "maxItems": 200 },
        "created": { "type": "integer" },
        "modified": { "type": "integer" },
        "version": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "companyId", "storeId", "type", "date", "status", "items", "created", "modified", "version"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Photographed or imported invoice linked to a store and optional delivery/pickup, with immutable signed PDF state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "jobId": { "type": ["string", "null"], "maxLength": 128 },
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 160 },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["not_signed", "signed", "pending_upload", "synchronized", "upload_failed", "voided"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedesInvoiceId": { "type": ["string", "null"], "maxLength": 128 },
        "voidedReason": { "type": ["string", "null"], "maxLength": 500 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "signed": { "type": "boolean" },
        "recipientName": { "type": "string", "maxLength": 120 },
        "recipientTitle": { "type": "string", "maxLength": 120 },
        "acknowledgmentConfirmed": { "type": "boolean" },
        "signedLocalAt": { "type": ["integer", "null"] },
        "signedServerAt": { "type": ["string", "null"], "format": "date-time" },
        "signedPdfStoragePath": { "type": ["string", "null"], "maxLength": 512 },
        "signedPdfSha256": { "type": ["string", "null"], "maxLength": 64 },
        "pages": { "type": "array", "maxItems": 30 }
      },
      "required": ["id", "companyId", "storeId", "invoiceNumber", "status", "version", "createdByUid", "signed"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only operational audit log for company actions, role updates, and invoice signing/voiding.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["owner", "manager", "driver", "accountant"] },
        "action": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "integer" },
        "serverTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "serverTimestamp"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Tenant root document."
    },
    "/companies/{companyId}/employees/{uid}": {
      "schema": "Employee",
      "description": "Active and deactivated employees belonging to the company."
    },
    "/companies/{companyId}/invitations/{inviteId}": {
      "schema": "Invitation",
      "description": "Owner-issued employee invitations redeemed via trusted Cloud Function."
    },
    "/companies/{companyId}/stores/{storeId}": {
      "schema": "Store",
      "description": "Company stores and receiving hours."
    },
    "/companies/{companyId}/jobs/{jobId}": {
      "schema": "Job",
      "description": "Company deliveries and pickups."
    },
    "/companies/{companyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Company invoices with immutable signed records."
    },
    "/companies/{companyId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only audit trail."
    }
  }
}
