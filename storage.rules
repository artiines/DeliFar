rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[A-Za-z0-9_-]+$');
    }

    function validInvoiceFileName(fileName) {
      return fileName.size() <= 160 && (
        fileName.matches('^(orig|edit)_[A-Za-z0-9_-]{1,120}\\.(jpg|jpeg|png)$')
        || fileName == 'signature.png'
        || fileName.matches('^signed_v[0-9]{1,6}\\.pdf$')
      );
    }

    function employeePath(companyId) {
      return /databases/(default)/documents/companies/$(companyId)/employees/$(request.auth.uid);
    }

    function invoicePath(companyId, invoiceId) {
      return /databases/(default)/documents/companies/$(companyId)/invoices/$(invoiceId);
    }

    function isActiveMember(companyId) {
      return isSignedIn()
        && isValidId(companyId)
        && firestore.exists(employeePath(companyId))
        && firestore.get(employeePath(companyId)).data.active == true
        && firestore.get(employeePath(companyId)).data.companyId == companyId;
    }

    function memberRole(companyId) {
      return firestore.get(employeePath(companyId)).data.role;
    }

    function isOwnerOrManager(companyId) {
      return isActiveMember(companyId)
        && memberRole(companyId) in ['owner', 'manager'];
    }

    function isOwnerManagerOrAccountant(companyId) {
      return isActiveMember(companyId)
        && memberRole(companyId) in ['owner', 'manager', 'accountant'];
    }

    function isDriver(companyId) {
      return isActiveMember(companyId)
        && memberRole(companyId) == 'driver';
    }

    function isDriverInvoiceParticipant(companyId, invoiceId) {
      return isDriver(companyId)
        && isValidId(invoiceId)
        && firestore.exists(invoicePath(companyId, invoiceId))
        && (
          firestore.get(invoicePath(companyId, invoiceId)).data.createdByUid == request.auth.uid
          || firestore.get(invoicePath(companyId, invoiceId)).data.assignedDriverUid == request.auth.uid
        );
    }

    function invoiceNotAlreadySigned(companyId, invoiceId) {
      return !firestore.exists(invoicePath(companyId, invoiceId))
        || firestore.get(invoicePath(companyId, invoiceId)).data.signed != true;
    }

    function canUploadToInvoice(companyId, invoiceId) {
      return isValidId(invoiceId)
        && invoiceNotAlreadySigned(companyId, invoiceId)
        && (
          isOwnerOrManager(companyId)
          || (isDriver(companyId) && (
            !firestore.exists(invoicePath(companyId, invoiceId))
            || firestore.get(invoicePath(companyId, invoiceId)).data.createdByUid == request.auth.uid
            || firestore.get(invoicePath(companyId, invoiceId)).data.assignedDriverUid == request.auth.uid
          ))
        );
    }

    function validInvoiceContentType() {
      return request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    function withinSizeLimit() {
      // 15 MB per file ceiling
      return request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024;
    }

    // Private company invoice storage: originals, edited pages, signature PNGs, signed PDFs
    match /companies/{companyId}/invoices/{invoiceId}/{fileName} {
      // Owners, Managers, Accountants may read all company invoices;
      // Drivers may ONLY read files for invoices they created or are assigned to.
      allow read: if isOwnerManagerOrAccountant(companyId)
        || isDriverInvoiceParticipant(companyId, invoiceId);

      // Write-once uploads restricted by role, invoice ownership, unsigned state, filename pattern, MIME, and size
      allow create: if canUploadToInvoice(companyId, invoiceId)
        && validInvoiceFileName(fileName)
        && withinSizeLimit()
        && validInvoiceContentType();

      // Signed PDFs, signature PNGs, and untouched original photographs cannot be overwritten;
      // updates to edited pages are only allowed while the invoice is not yet signed.
      allow update: if canUploadToInvoice(companyId, invoiceId)
        && validInvoiceFileName(fileName)
        && !fileName.matches('^signed_.*\\.pdf$')
        && !fileName.matches('^orig_.*')
        && fileName != 'signature.png'
        && withinSizeLimit()
        && validInvoiceContentType();

      allow delete: if false;
    }

    // Default-deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
