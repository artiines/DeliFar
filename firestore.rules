rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\.]{2}.*');
    }

    function employeePath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/employees/$(uid);
    }

    function isActiveMember(companyId) {
      return isSignedIn()
        && isValidId(companyId)
        && exists(employeePath(companyId, request.auth.uid))
        && get(employeePath(companyId, request.auth.uid)).data.active == true
        && get(employeePath(companyId, request.auth.uid)).data.companyId == companyId;
    }

    function memberRole(companyId) {
      return get(employeePath(companyId, request.auth.uid)).data.role;
    }

    function isOwner(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) == 'owner';
    }

    function isOwnerOrManager(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) in ['owner', 'manager'];
    }

    function isDriver(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) == 'driver';
    }

    function isAccountant(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) == 'accountant';
    }

    function canUploadOrSignInvoices(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) in ['owner', 'manager', 'driver'];
    }

    function validRole(role) {
      return role in ['owner', 'manager', 'driver', 'accountant'];
    }

    function validJobStatus(status) {
      return status in ['pending', 'progress', 'completed', 'canceled'];
    }

    function validJobType(t) {
      return t in ['delivery', 'pickup'];
    }

    function validInvoiceStatus(s) {
      return s in ['not_signed', 'signed', 'pending_upload', 'synchronized', 'upload_failed', 'voided'];
    }

    function signedInvoiceImmutableFieldsUnchanged() {
      return request.resource.data.signed == true
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.version == resource.data.version
        && request.resource.data.recipientName == resource.data.recipientName
        && request.resource.data.recipientTitle == resource.data.recipientTitle
        && request.resource.data.acknowledgmentConfirmed == resource.data.acknowledgmentConfirmed
        && request.resource.data.signedLocalAt == resource.data.signedLocalAt
        && request.resource.data.signedPdfStoragePath == resource.data.signedPdfStoragePath
        && request.resource.data.signedPdfSha256 == resource.data.signedPdfSha256
        && request.resource.data.signatureStoragePath == resource.data.signatureStoragePath
        && request.resource.data.pages == resource.data.pages;
    }

    // =========================================================================
    // Company Root Document: /companies/{companyId}
    // =========================================================================

    match /companies/{companyId} {
      allow get: if isActiveMember(companyId);
      allow list: if false;

      // Owner registers a brand-new company bound to their own UID
      allow create: if isSignedIn()
        && isValidId(companyId)
        && request.resource.data.id == companyId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() >= 1
        && request.resource.data.timezone.size() <= 64
        && request.resource.data.defaultArea in ['LA', 'SAC'];

      // Only the active company Owner can update company settings (never reassign ownerUid silently)
      allow update: if isOwner(companyId)
        && request.resource.data.id == companyId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.timezone is string
        && request.resource.data.defaultArea in ['LA', 'SAC'];

      allow delete: if false;

      // =======================================================================
      // Employees: /companies/{companyId}/employees/{uid}
      // =======================================================================

      match /employees/{uid} {
        allow get, list: if isActiveMember(companyId);

        // Initial owner bootstrapping their own membership on company creation,
        // or Owner adding an employee record.
        allow create: if isSignedIn()
          && isValidId(uid)
          && request.resource.data.uid == uid
          && request.resource.data.companyId == companyId
          && validRole(request.resource.data.role)
          && request.resource.data.active is bool
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && (
            (uid == request.auth.uid
              && request.resource.data.role == 'owner'
              && request.resource.data.active == true
              && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid)
            || isOwner(companyId)
          );

        // Owner can change roles/active status; individual active user may only update
        // their own fcmToken, phone, displayName, or lastActiveAt (NEVER role/active/companyId).
        allow update: if isActiveMember(companyId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.companyId == companyId
          && validRole(request.resource.data.role)
          && (
            isOwner(companyId)
            || (
              uid == request.auth.uid
              && request.resource.data.role == resource.data.role
              && request.resource.data.active == resource.data.active
              && request.resource.data.email == resource.data.email
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fcmToken', 'phone', 'displayName', 'lastActiveAt', 'serverUpdatedAt'])
            )
          );

        allow delete: if false;
      }

      // =======================================================================
      // Invitations: /companies/{companyId}/invitations/{inviteId}
      // =======================================================================

      match /invitations/{inviteId} {
        allow get, list: if isOwner(companyId);

        allow create: if isOwner(companyId)
          && isValidId(inviteId)
          && request.resource.data.id == inviteId
          && request.resource.data.companyId == companyId
          && request.resource.data.role in ['manager', 'driver', 'accountant']
          && request.resource.data.status == 'pending'
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 3
          && request.resource.data.email.size() <= 254;

        // Owner can revoke pending invitations; acceptance happens in Cloud Function Admin SDK
        allow update: if isOwner(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.status in ['pending', 'revoked'];

        allow delete: if false;
      }

      // =======================================================================
      // Stores: /companies/{companyId}/stores/{storeId}
      // =======================================================================

      match /stores/{storeId} {
        allow get, list: if isActiveMember(companyId);

        allow create, update: if isOwnerOrManager(companyId)
          && isValidId(storeId)
          && request.resource.data.id == storeId
          && request.resource.data.companyId == companyId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 160
          && request.resource.data.address is string
          && request.resource.data.address.size() >= 1
          && request.resource.data.address.size() <= 300
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lon is number
          && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
          && request.resource.data.archived is bool
          && request.resource.data.version is int && request.resource.data.version >= 1;

        allow delete: if false;
      }

      // =======================================================================
      // Jobs (Deliveries & Pickups): /companies/{companyId}/jobs/{jobId}
      // =======================================================================

      match /jobs/{jobId} {
        // Owner, Manager, Accountant can view all company jobs;
        // Drivers can ONLY read jobs assigned to them.
        allow get, list: if isActiveMember(companyId) && (
          memberRole(companyId) in ['owner', 'manager', 'accountant']
          || (isDriver(companyId) && resource.data.assignedDriverUid == request.auth.uid)
        );

        allow create: if isOwnerOrManager(companyId)
          && isValidId(jobId)
          && request.resource.data.id == jobId
          && request.resource.data.companyId == companyId
          && validJobType(request.resource.data.type)
          && validJobStatus(request.resource.data.status)
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 200;

        // Owner/Manager can update any job fields;
        // Driver can ONLY update status, issue, issueNote, items (actuals), completed, modified, version
        // on jobs assigned to them, and CANNOT change assignedDriverUid or storeId.
        allow update: if isActiveMember(companyId)
          && request.resource.data.id == jobId
          && request.resource.data.companyId == companyId
          && validJobType(request.resource.data.type)
          && validJobStatus(request.resource.data.status)
          && (
            isOwnerOrManager(companyId)
            || (
              isDriver(companyId)
              && resource.data.assignedDriverUid == request.auth.uid
              && request.resource.data.assignedDriverUid == resource.data.assignedDriverUid
              && request.resource.data.storeId == resource.data.storeId
              && request.resource.data.type == resource.data.type
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'issue', 'issueNote', 'items', 'completed', 'modified', 'version', 'updatedByUid', 'serverUpdatedAt'])
            )
          );

        allow delete: if false;
      }

      // =======================================================================
      // Invoices: /companies/{companyId}/invoices/{invoiceId}
      // =======================================================================

      match /invoices/{invoiceId} {
        allow get, list: if isActiveMember(companyId) && (
          memberRole(companyId) in ['owner', 'manager', 'accountant']
          || (isDriver(companyId) && resource.data.createdByUid == request.auth.uid)
        );

        allow create: if canUploadOrSignInvoices(companyId)
          && isValidId(invoiceId)
          && request.resource.data.id == invoiceId
          && request.resource.data.companyId == companyId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.invoiceNumber is string
          && request.resource.data.invoiceNumber.size() >= 1
          && request.resource.data.invoiceNumber.size() <= 80
          && validInvoiceStatus(request.resource.data.status)
          && request.resource.data.version is int && request.resource.data.version >= 1
          && request.resource.data.signed is bool;

        allow update: if isActiveMember(companyId)
          && request.resource.data.id == invoiceId
          && request.resource.data.companyId == companyId
          && validInvoiceStatus(request.resource.data.status)
          && (
            // Case 1: Invoice is not yet signed -> Owner, Manager, or creating Driver may update or sign it
            (
              resource.data.signed == false
              && (isOwnerOrManager(companyId) || (isDriver(companyId) && resource.data.createdByUid == request.auth.uid))
              && (!request.resource.data.signed || (
                request.resource.data.acknowledgmentConfirmed == true
                && request.resource.data.recipientName is string
                && request.resource.data.recipientName.size() >= 1
                && request.resource.data.recipientName.size() <= 120
              ))
            )
            // Case 2: Invoice is already signed -> STRICTLY IMMUTABLE except Owner/Manager voiding
            // or attaching finalized Storage paths right after offline capture upload
            || (
              resource.data.signed == true
              && signedInvoiceImmutableFieldsUnchanged()
              && (
                (isOwnerOrManager(companyId)
                  && request.resource.data.status == 'voided'
                  && request.resource.data.voidedReason is string
                  && request.resource.data.voidedReason.size() >= 1)
                || (
                  canUploadOrSignInvoices(companyId)
                  && resource.data.status in ['signed', 'pending_upload', 'upload_failed']
                  && request.resource.data.status == 'synchronized'
                )
              )
            )
          );

        allow delete: if false;
      }

      // =======================================================================
      // Audit Logs (Append-Only): /companies/{companyId}/auditLogs/{logId}
      // =======================================================================

      match /auditLogs/{logId} {
        allow get, list: if isOwnerOrManager(companyId);

        allow create: if isActiveMember(companyId)
          && isValidId(logId)
          && request.resource.data.id == logId
          && request.resource.data.companyId == companyId
          && request.resource.data.serverTimestamp == request.time;

        allow update, delete: if false;
      }
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
