rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions (optimized to stay far below Firestore's 1000-expression cap)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\.]{2}.*');
    }

    function employeePath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/employees/$(uid);
    }

    function isActiveMember(companyId) {
      return isSignedIn()
        && isValidId(companyId)
        && exists(employeePath(companyId, request.auth.uid))
        && get(employeePath(companyId, request.auth.uid)).data.active == true
        && get(employeePath(companyId, request.auth.uid)).data.companyId == companyId;
    }

    function memberRole(companyId) {
      return get(employeePath(companyId, request.auth.uid)).data.role;
    }

    function isOwner(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) == 'owner';
    }

    function isOwnerOrManager(companyId) {
      return isActiveMember(companyId) && memberRole(companyId) in ['owner', 'manager'];
    }

    function driverOwnsOrAssigned(invData) {
      return invData.createdByUid == request.auth.uid
        || ('assignedDriverUid' in invData && invData.assignedDriverUid == request.auth.uid);
    }

    function validRole(role) {
      return role in ['owner', 'manager', 'driver', 'accountant'];
    }

    function validJobStatus(status) {
      return status in ['pending', 'progress', 'completed', 'canceled'];
    }

    function validJobType(t) {
      return t in ['delivery', 'pickup'];
    }

    function validInvoiceStatus(s) {
      return s in ['not_signed', 'signed', 'pending_upload', 'synchronized', 'upload_failed', 'voided'];
    }

    function validStoreCoords(lat, lon) {
      return lat is number
        && lon is number
        && lat >= -90 && lat <= 90
        && lon >= -180 && lon <= 180
        && !(lat == 0 && lon == 0);
    }

    function validSignatureFields(data) {
      return data.acknowledgmentConfirmed == true
        && data.recipientName is string
        && data.recipientName.size() >= 1
        && data.recipientName.size() <= 120;
    }

    function signedInvoiceImmutableFieldsUnchanged() {
      let req = request.resource.data;
      let cur = resource.data;
      return req.signed == true
        && req.companyId == cur.companyId
        && req.storeId == cur.storeId
        && req.createdByUid == cur.createdByUid
        && req.invoiceNumber == cur.invoiceNumber
        && req.version == cur.version
        && req.recipientName == cur.recipientName
        && req.recipientTitle == cur.recipientTitle
        && req.acknowledgmentConfirmed == cur.acknowledgmentConfirmed
        && req.signedLocalAt == cur.signedLocalAt
        && req.signedPdfStoragePath == cur.signedPdfStoragePath
        && req.signedPdfSha256 == cur.signedPdfSha256
        && req.signatureStoragePath == cur.signatureStoragePath
        && req.pages == cur.pages;
    }

    function canUpdateInvoice(companyId, invoiceId) {
      let req = request.resource.data;
      let cur = resource.data;
      let role = memberRole(companyId);
      let isMgr = role in ['owner', 'manager'];
      let isAuthDriver = role == 'driver' && driverOwnsOrAssigned(cur);
      let changedKeys = req.diff(cur).affectedKeys();

      return isActiveMember(companyId)
        && req.id == invoiceId
        && req.companyId == companyId
        && req.createdByUid == cur.createdByUid
        && validInvoiceStatus(req.status)
        && (
          // Case 1: Unsigned invoice -> Owner, Manager, or authorized Driver may update or sign it
          (
            cur.signed == false
            && (isMgr || isAuthDriver)
            && (!req.signed || validSignatureFields(req))
          )
          // Case 2: Already signed -> STRICTLY IMMUTABLE except:
          //   (a) Owner/Manager voiding a non-voided signed invoice with a mandatory reason
          //   (b) Authorized uploader finalizing sync status to synchronized
          || (
            cur.signed == true
            && cur.status != 'voided'
            && signedInvoiceImmutableFieldsUnchanged()
            && (
              (isMgr
                && req.status == 'voided'
                && req.voidedReason is string
                && req.voidedReason.size() >= 1
                && changedKeys.hasOnly(['status', 'voidedReason', 'modifiedAt', 'serverUpdatedAt']))
              || (
                (isMgr || isAuthDriver)
                && cur.status in ['signed', 'pending_upload', 'upload_failed']
                && req.status == 'synchronized'
                && changedKeys.hasOnly(['status', 'modifiedAt', 'serverUpdatedAt', 'signedServerAt'])
              )
            )
          )
        );
    }

    function canUpdateJob(companyId, jobId) {
      let req = request.resource.data;
      let cur = resource.data;
      let role = memberRole(companyId);
      return isActiveMember(companyId)
        && req.id == jobId
        && req.companyId == companyId
        && validJobType(req.type)
        && validJobStatus(req.status)
        && (
          role in ['owner', 'manager']
          || (
            role == 'driver'
            && cur.assignedDriverUid == request.auth.uid
            && req.assignedDriverUid == cur.assignedDriverUid
            && req.storeId == cur.storeId
            && req.type == cur.type
            && req.diff(cur).affectedKeys()
              .hasOnly(['status', 'issue', 'issueNote', 'items', 'completed', 'modified', 'version', 'updatedByUid', 'serverUpdatedAt'])
          )
        );
    }

    function canUpdateEmployee(companyId, uid) {
      let req = request.resource.data;
      let cur = resource.data;
      let role = memberRole(companyId);
      return isActiveMember(companyId)
        && req.uid == cur.uid
        && req.companyId == companyId
        && validRole(req.role)
        && (
          (role == 'owner'
            && !(uid == request.auth.uid && (req.active == false || req.role != 'owner')))
          || (
            uid == request.auth.uid
            && req.role == cur.role
            && req.active == cur.active
            && req.email == cur.email
            && req.diff(cur).affectedKeys()
              .hasOnly(['fcmToken', 'phone', 'displayName', 'lastActiveAt', 'serverUpdatedAt'])
          )
        );
    }

    // =========================================================================
    // Company Root Document: /companies/{companyId}
    // =========================================================================

    match /companies/{companyId} {
      allow get: if isActiveMember(companyId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(companyId)
        && request.resource.data.id == companyId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() >= 1
        && request.resource.data.timezone.size() <= 64
        && request.resource.data.defaultArea in ['la', 'sac', 'LA', 'SAC'];

      allow update: if isOwner(companyId)
        && request.resource.data.id == companyId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.timezone is string
        && request.resource.data.defaultArea in ['la', 'sac', 'LA', 'SAC'];

      allow delete: if false;

      // =======================================================================
      // Employees: /companies/{companyId}/employees/{uid}
      // =======================================================================

      match /employees/{uid} {
        allow get, list: if isActiveMember(companyId);

        allow create: if isSignedIn()
          && isValidId(uid)
          && request.resource.data.uid == uid
          && request.resource.data.companyId == companyId
          && validRole(request.resource.data.role)
          && request.resource.data.active is bool
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && (
            (uid == request.auth.uid
              && request.resource.data.role == 'owner'
              && request.resource.data.active == true
              && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid)
            || isOwner(companyId)
          );

        allow update: if canUpdateEmployee(companyId, uid);
        allow delete: if false;
      }

      // =======================================================================
      // Invitations: /companies/{companyId}/invitations/{inviteId}
      // =======================================================================

      match /invitations/{inviteId} {
        allow get, list: if isOwner(companyId);

        allow create: if isOwner(companyId)
          && isValidId(inviteId)
          && request.resource.data.id == inviteId
          && request.resource.data.companyId == companyId
          && request.resource.data.role in ['manager', 'driver', 'accountant']
          && request.resource.data.status == 'pending'
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 3
          && request.resource.data.email.size() <= 254;

        allow update: if isOwner(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.status in ['pending', 'revoked'];

        allow delete: if false;
      }

      // =======================================================================
      // Stores: /companies/{companyId}/stores/{storeId}
      // =======================================================================

      match /stores/{storeId} {
        allow get, list: if isActiveMember(companyId);

        allow create, update: if isOwnerOrManager(companyId)
          && isValidId(storeId)
          && request.resource.data.id == storeId
          && request.resource.data.companyId == companyId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 160
          && request.resource.data.address is string
          && request.resource.data.address.size() >= 1
          && request.resource.data.address.size() <= 300
          && validStoreCoords(request.resource.data.lat, request.resource.data.lon)
          && request.resource.data.archived is bool
          && request.resource.data.version is int && request.resource.data.version >= 1;

        allow delete: if false;
      }

      // =======================================================================
      // Jobs (Deliveries & Pickups): /companies/{companyId}/jobs/{jobId}
      // =======================================================================

      match /jobs/{jobId} {
        allow get, list: if isActiveMember(companyId) && (
          memberRole(companyId) in ['owner', 'manager', 'accountant']
          || (memberRole(companyId) == 'driver' && resource.data.assignedDriverUid == request.auth.uid)
        );

        allow create: if isOwnerOrManager(companyId)
          && isValidId(jobId)
          && request.resource.data.id == jobId
          && request.resource.data.companyId == companyId
          && validJobType(request.resource.data.type)
          && validJobStatus(request.resource.data.status)
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 200;

        allow update: if canUpdateJob(companyId, jobId);
        allow delete: if false;
      }

      // =======================================================================
      // Invoices: /companies/{companyId}/invoices/{invoiceId}
      // =======================================================================

      match /invoices/{invoiceId} {
        allow get, list: if isActiveMember(companyId) && (
          memberRole(companyId) in ['owner', 'manager', 'accountant']
          || (memberRole(companyId) == 'driver' && driverOwnsOrAssigned(resource.data))
        );

        allow create: if isActiveMember(companyId)
          && memberRole(companyId) in ['owner', 'manager', 'driver']
          && isValidId(invoiceId)
          && request.resource.data.id == invoiceId
          && request.resource.data.companyId == companyId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.invoiceNumber is string
          && request.resource.data.invoiceNumber.size() >= 1
          && request.resource.data.invoiceNumber.size() <= 80
          && validInvoiceStatus(request.resource.data.status)
          && request.resource.data.version is int && request.resource.data.version >= 1
          && request.resource.data.signed is bool
          && (!request.resource.data.signed || validSignatureFields(request.resource.data))
          && (memberRole(companyId) != 'driver'
              || !('assignedDriverUid' in request.resource.data)
              || request.resource.data.assignedDriverUid == null
              || request.resource.data.assignedDriverUid == request.auth.uid);

        allow update: if canUpdateInvoice(companyId, invoiceId);
        allow delete: if false;
      }

      // =======================================================================
      // Audit Logs (Append-Only): /companies/{companyId}/auditLogs/{logId}
      // =======================================================================

      match /auditLogs/{logId} {
        allow get, list: if isOwnerOrManager(companyId);

        allow create: if isActiveMember(companyId)
          && isValidId(logId)
          && request.resource.data.id == logId
          && request.resource.data.companyId == companyId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.action.size() >= 1
          && request.resource.data.action.size() <= 80
          && request.resource.data.serverTimestamp == request.time;

        allow update, delete: if false;
      }
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
